@model RaceDay.MVC.Models.ManageEventCategoriesViewModel

@{
    ViewData["Title"] = "Manage Event Categories";
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-controller="Organiser"
           asp-action="Index"
           class="text-decoration-none">
            &larr; Back to My Events
        </a>
    </div>

    <div class="mb-4">
        <h1 class="fw-bold">Manage Event Categories</h1>
        <p class="text-muted">@Model.EventName</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- ASSIGNED CATEGORIES -->

    <div class="card mb-4">
        <div class="card-body p-4">

            <h4 class="fw-bold mb-4">
                Assigned Categories
            </h4>

            @if (!Model.AssignedCategories.Any())
            {
                <p class="text-muted">
                    No categories have been assigned to this event.
                </p>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Entry Fee</th>
                                <th>Maximum Participants</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var category in Model.AssignedCategories)
                            {
                                <tr>
                                    <td>
                                        <strong>
                                            @category.CategoryName
                                        </strong>

                                        <div class="text-muted small">
                                            @category.Description
                                        </div>
                                    </td>

                                    <td>
                                        R @category.EntryFee.ToString("N2")
                                    </td>

                                    <td>
                                        @(category.MaxParticipants?.ToString()
                                            ?? "Unlimited")
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2 align-items-center">

                                            <a asp-controller="EventCategories"
                                               asp-action="Edit"
                                               asp-route-eventId="@Model.EventID"
                                               asp-route-categoryId="@category.CategoryID"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <form asp-controller="EventCategories"
                                                  asp-action="Remove"
                                                  asp-route-eventId="@Model.EventID"
                                                  asp-route-categoryId="@category.CategoryID"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to remove this category from the event?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Remove
                                                </button>

                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

    <!-- ASSIGN NEW CATEGORY -->

    <div class="card">
        <div class="card-body p-4">

            <h4 class="fw-bold mb-3">
                Assign New Category
            </h4>

            @if (!Model.NewCategory.AvailableCategories.Any())
            {
                <div class="alert alert-info">
                    All available categories are already assigned
                    to this event.
                </div>
            }
            else
            {
                <form asp-controller="EventCategories"
                      asp-action="Add"
                      asp-route-eventId="@Model.EventID"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="row g-3">

                        <div class="col-md-12">
                            <label class="form-label">
                                Race Category
                            </label>

                            <select name="CategoryID"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select a category
                                </option>

                                @foreach (var category in
                                    Model.NewCategory.AvailableCategories)
                                {
                                    <option value="@category.Value">
                                        @category.Text
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Entry Fee (R)
                            </label>

                            <input name="EntryFee"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   value="0"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Maximum Participants
                            </label>

                            <input name="MaxParticipants"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Leave blank for unlimited" />

                            <small class="text-muted">
                                Leave blank for unlimited participants.
                            </small>
                        </div>

                    </div>

                    <button type="submit"
                            class="btn btn-raceday mt-4">
                        Assign Category
                    </button>

                </form>
            }

        </div>
    </div>

</div>


@{
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var isOrganiser = User.IsInRole("Organiser");
    var isParticipant = User.IsInRole("Participant");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg
                    navbar-dark raceday-navbar">

            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-icon">⚑</span>
                    RaceDay
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (isOrganiser)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Events"
                                   asp-action="Index">
                                    Manage Events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Enrolments"
                                   asp-action="Index">
                                    Enrolments
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Results"
                                   asp-action="Index">
                                    Results
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                    asp-controller="Categories"
                                    asp-action="Index">
                                     Categories
                                </a>
                            </li>

                        }

                        @if (isParticipant)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Events"
                                   asp-action="Index">
                                    Browse Events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Enrolments"
                                   asp-action="MyEnrolments">
                                    My Enrolments
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Results"
                                   asp-action="MyResults">
                                    My Results
                                </a>
                            </li>
                            
                            @if (User.Identity?.IsAuthenticated == true &&
                                 User.IsInRole("Participant"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                        asp-controller="Enrolments"
                                        asp-action="My">
                                         My Enrolments
                                    </a>
                                </li>
                            }

                        }

                    </ul>

                    <ul class="navbar-nav ms-auto
                               align-items-lg-center">

                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <span class="nav-link">
                                    Hello, @User.Identity?.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-light
                                                   btn-sm ms-lg-2">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-raceday
                                          btn-sm ms-lg-2"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <footer class="raceday-footer">
        <div class="container text-center">
            <p class="mb-0">
                &copy; @DateTime.Now.Year RaceDay.
                All rights reserved.
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

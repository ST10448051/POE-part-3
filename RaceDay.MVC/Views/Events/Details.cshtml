@model RaceDay.MVC.Models.EventViewModel

@{
    ViewData["Title"] = Model.EventName;

    var statusClass = Model.Status switch
    {
        "Open" => "bg-success",
        "Upcoming" => "bg-primary",
        "Completed" => "bg-secondary",
        "Cancelled" => "bg-danger",
        "Closed" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

<div class="container py-5">

    <div class="mb-4">
        <a asp-controller="Events"
           asp-action="Index"
           class="text-decoration-none">
            &larr; Back to Events
        </a>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card mb-4">
                <div class="card-body p-4">

                    <span class="badge @statusClass mb-3">
                        @Model.Status
                    </span>

                    <h1 class="fw-bold mb-3">
                        @Model.EventName
                    </h1>

                    <p class="lead text-muted">
                        @Model.Description
                    </p>

                </div>
            </div>

            <div class="card">
                <div class="card-body p-4">

                    <h3 class="fw-bold mb-4">
                        Event Information
                    </h3>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <h6 class="text-muted">Date</h6>
                            <p class="fw-semibold">
                                @Model.EventDate.ToString(
                                    "dddd, dd MMMM yyyy")
                            </p>
                        </div>

                        <div class="col-md-6">
                            <h6 class="text-muted">Location</h6>
                            <p class="fw-semibold">
                                @Model.Location
                            </p>
                        </div>

                        <div class="col-md-6">
                            <h6 class="text-muted">Distance</h6>
                            <p class="fw-semibold">
                                @Model.DistanceKm km
                            </p>
                        </div>

                        <div class="col-md-6">
                            <h6 class="text-muted">Event Type</h6>
                            <p class="fw-semibold">
                                @Model.EventType
                            </p>
                        </div>

                    </div>

                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card">
                <div class="card-body p-4">

                    <h4 class="fw-bold mb-3">
                        Race Entry
                    </h4>

                    <p class="text-muted mb-1">
                        Entry Fee
                    </p>

                    <h2 class="fw-bold mb-4">
                        R @Model.EntryFee.ToString("N2")
                    </h2>

                    @if (Model.Status == "Open")
                    {
                        @if (User.Identity?.IsAuthenticated == true &&
                             User.IsInRole("Participant") &&
                             Model.Status == "Open")
                        {
                            <a asp-controller="Enrolments"
                               asp-action="Create"
                               asp-route-eventId="@Model.EventID"
                               class="btn btn-raceday">
                                Enrol Now
                            </a>
                        }
                        else if (User.Identity?.IsAuthenticated != true &&
                                 Model.Status == "Open")
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-raceday">
                                Log In to Enrol
                            </a>
                        }
                        else if (User.Identity?.IsAuthenticated != true)
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-raceday w-100">
                                Login to Enrol
                            </a>
                        }
                        else
                        {
                            <p class="text-muted">
                                Only Participants can enrol.
                            </p>
                        }
                    }
                    else
                    {
                        <div class="alert alert-secondary">
                            Registration is not currently open.
                        </div>
                    }

                    <a asp-controller="Results"
                       asp-action="Event"
                       asp-route-eventId="@Model.EventID"
                       class="btn btn-outline-primary">
                        View Race Results
                    </a>

                    <a asp-controller="EventMedia"
                       asp-action="Index"
                       asp-route-eventId="@Model.EventID"
                       class="btn btn-outline-primary">
                        View Event Gallery
                    </a>

                </div>
            </div>

        </div>

    </div>
</div>

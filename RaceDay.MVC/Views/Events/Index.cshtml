@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container py-5">

    <div class="mb-5">
        <h1 class="fw-bold">Upcoming Events</h1>
        <p class="text-muted">
            Find your next challenge and join the race!
        </p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h4>No upcoming events found</h4>
                <p class="text-muted">
                    Check back soon for new races.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var race in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 event-card">

                        <div class="card-body">

                            <span class="badge bg-success mb-3">
                                @race.Status
                            </span>

                            <h4 class="fw-bold">
                                @race.EventName
                            </h4>

                            <p class="text-muted">
                                @race.Description
                            </p>

                            <hr />

                            <p>
                                <strong>Date:</strong>
                                @race.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @race.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @race.DistanceKm km
                            </p>

                            <p>
                                <strong>Entry Fee:</strong>
                                R @race.EntryFee.ToString("N2")
                            </p>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@race.EventID"
                               class="btn btn-raceday w-100">
                                View Event
                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>

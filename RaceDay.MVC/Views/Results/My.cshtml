@model List<RaceDay.MVC.Models.MyResultViewModel>

@{
    ViewData["Title"] = "My Race Results";
}

<div class="container py-5">

    <h1 class="fw-bold mb-4">My Race Results</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You do not have any recorded race results yet.
        </div>

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-primary">
            Browse Events
        </a>
    }
    else
    {
        <div class="row g-4">

            @foreach (var result in Model)
            {
                <div class="col-md-6">

                    <div class="card h-100 shadow-sm">
                        <div class="card-body">

                            <h4 class="fw-bold">
                                @result.EventName
                            </h4>

                            <p class="text-muted">
                                @result.CategoryName
                            </p>

                            <hr />

                            <p>
                                <strong>Position:</strong>
                                @(result.Position?.ToString() ?? "—")
                            </p>

                            <p>
                                <strong>Finish Time:</strong>
                                @result.DisplayFinishTime
                            </p>

                            <p>
                                <strong>Status:</strong>
                                @result.DisplayStatus
                            </p>

                            <p class="text-muted mb-0">
                                Recorded:
                                @result.RecordedAt.ToString("dd MMM yyyy")
                            </p>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>

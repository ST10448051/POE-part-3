@model List<RaceDay.MVC.Models.MyEnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container py-5">

    <div class="d-flex justify-content-between
        align-items-center mb-4">

        <div>
            <h1 class="fw-bold">My Enrolments</h1>

            <p class="text-muted">
                View and manage your race registrations.
            </p>
        </div>

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-raceday">
            Browse Events
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">

                <h4>No Enrolments Yet</h4>

                <p class="text-muted">
                    You haven't enrolled in any race events yet.
                </p>

                <a asp-controller="Events"
                   asp-action="Index"
                   class="btn btn-raceday">
                    Explore Events
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-4">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Category</th>
                                <th>Enrolment Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var enrolment in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @enrolment.EventName
                                        </strong>
                                    </td>

                                    <td>
                                        @enrolment.CategoryName
                                    </td>

                                    <td>
                                        @enrolment.EnrolmentDate
                                        .ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @if (enrolment.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>
                                        }
                                        else if (enrolment.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (enrolment.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else if (enrolment.Status == "Completed")
                                        {
                                            <span class="badge bg-primary">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @enrolment.Status
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        @if (enrolment.Status == "Confirmed" ||
                                             enrolment.Status == "Pending")
                                        {
                                            <form asp-controller="Enrolments"
                                                  asp-action="Cancel"
                                                  asp-route-id="@enrolment.EnrolmentID"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to cancel this enrolment?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Cancel
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No actions available
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }

</div>

@model RaceDay.MVC.Models.EventViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container py-5">

    <div class="card border-danger">
        <div class="card-body p-4">

            <h2 class="text-danger fw-bold">
                Delete Event
            </h2>

            <p class="lead">
                Are you sure you want to delete this event?
            </p>

            <div class="alert alert-warning">
                This action cannot be undone.
            </div>

            <h4>@Model.EventName</h4>

            <p>
                <strong>Date:</strong>
                @Model.EventDate.ToString("dd MMM yyyy")
            </p>

            <p>
                <strong>Location:</strong>
                @Model.Location
            </p>

            <form asp-controller="Events"
                  asp-action="Delete"
                  asp-route-id="@Model.EventID"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger">
                    Yes, Delete Event
                </button>

                <a asp-controller="Organiser"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>
